# ==============================================================================
# CareBridge Environment Variables Template (Placeholders Only — Never Commit Real Secrets)
# ==============================================================================

# --- Frontend Public (Vercel) ---
# VITE_API_BASE_URL: Public HTTPS base URL of the Render Express backend (leave unset for same-origin/local dev).
VITE_API_BASE_URL=""

# --- Backend Server-Only (Render / Cloud Run / Local) ---
# FIREBASE_SERVICE_ACCOUNT_JSON: Single-line Firebase Admin SDK service account JSON (required on Render; optional locally with ADC).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# GEMINI_API_KEY: Required for CareBridge Care Assistant, translation & neural voice calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_TTS_API_KEY: Optional secondary Google Cloud Text-to-Speech API key fallback.
GOOGLE_CLOUD_TTS_API_KEY=""

# APP_URL: Public URL of the CareBridge frontend (Vercel production URL or local URL).
APP_URL="MY_APP_URL"

# CORS_ALLOWED_ORIGINS: Comma-separated explicit allowed frontend origins (e.g., https://carebridge.vercel.app).
CORS_ALLOWED_ORIGINS=""

# Optional strict Vercel preview matching (only matches https://<slug>-*.vercel.app when both are set).
CORS_ALLOW_VERCEL_PREVIEWS="false"
VERCEL_PREVIEW_PROJECT_SLUG=""

# PORT: Listening port for Express server (Render injects PORT automatically; local defaults to 3000).
PORT="3000"

# SCHEDULER_SECRET: Shared bearer token for authenticated scheduler dispatch calls.
SCHEDULER_SECRET="MY_CLOUD_SCHEDULER_SECRET"

# Optional Google Cloud Scheduler OIDC Token Verification.
SCHEDULER_OIDC_AUDIENCE=""
SCHEDULER_OIDC_SERVICE_ACCOUNT=""

# SMTP Email Configuration (leave EMAIL_TEST_MODE="true" / SMTP_HOST empty for safe test mode).
EMAIL_TEST_MODE="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CareBridge Alerts <no-reply@carebridge.local>"
