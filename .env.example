# GEMINI_API_KEY: Required for optional CareBridge Care Assistant & Neural Voice calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_TTS_API_KEY: Optional secondary Google Cloud Text-to-Speech API key fallback.
GOOGLE_CLOUD_TTS_API_KEY=""

# APP_URL: Public URL where CareBridge is hosted (Cloud Run URL or local URL).
APP_URL="MY_APP_URL"

# PORT: Listening port for Express server (Cloud Run defaults to 8080 or 3000 locally).
PORT="3000"

# SCHEDULER_SECRET: Shared bearer token for authenticated Google Cloud Scheduler dispatch calls.
SCHEDULER_SECRET="MY_CLOUD_SCHEDULER_SECRET"

# Optional Google Cloud Scheduler OIDC Token Verification (recommended on Cloud Run).
SCHEDULER_OIDC_AUDIENCE=""
SCHEDULER_OIDC_SERVICE_ACCOUNT=""

# SMTP Email Configuration (leave unset to run in safe EMAIL_TEST_MODE=true).
EMAIL_TEST_MODE="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CareBridge Alerts <no-reply@carebridge.local>"
